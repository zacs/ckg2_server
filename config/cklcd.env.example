# /etc/cklcd.env — environment for the cklcd.service front-panel daemon.
# Copy to /etc/cklcd.env (40-install-lcd.sh does this) and edit as you like,
# then: systemctl restart cklcd

# How often the status screen refreshes, in seconds.
CKLCD_INTERVAL=5

# Which filesystem's usage to show on the last line. Defaults to the bulk
# storage mount; cklcd falls back to / automatically if this path is absent.
CKLCD_DISK=/volume

# Font pixel size. 11 is a good default for the ~160x60 panel; drop to 9 or 10
# to fit more text, raise for readability at a distance.
CKLCD_FONT_SIZE=11

# Framebuffer device. You should never need to change this.
# CKLCD_FB=/dev/fb0

# The systemd unit runs `cklcd info`. To show something else, override ExecStart
# with `systemctl edit cklcd` instead of editing this file. Examples:
#   ExecStart=/usr/local/bin/cklcd text "hello\nworld"
#   ExecStart=/usr/local/bin/cklcd qr "https://my.server.lan"

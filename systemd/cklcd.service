[Unit]
Description=CloudKey front-panel status display (cklcd)
Documentation=https://github.com/zacs/ckg2_server/blob/main/docs/05-lcd.md
After=network-online.target
Wants=network-online.target
# The stock UI daemon and the jnovack daemon (41-install-cloudkey.sh) drive the
# same framebuffer; make sure neither runs alongside us and re-grabs the panel.
Conflicts=ck-ui.service cloudkey.service
# Don't crash-loop forever if /dev/fb0 is missing or busy.
StartLimitIntervalSec=60
StartLimitBurst=4

[Service]
Type=simple
EnvironmentFile=/etc/cklcd.env
ExecStart=/usr/local/bin/cklcd info
Restart=on-failure
RestartSec=5

# Light hardening. The daemon needs /dev/fb0, so device isolation stays off.
NoNewPrivileges=true
ProtectHome=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
